# Bản mẫu cấu hình chung: sao chép thành .env nếu cần.
# Mọi đường dẫn dưới đây tương đối với thư mục gốc dự án.
# Biến môi trường đã có trong terminal/kernel ưu tiên hơn file .env.

# --- Thị giác ---
# classical là baseline descriptor thủ công
RPV_ENCODER=dinov2
# vits14(384) | vitb14(768) | vitl14(1024) | vitg14(1536)
RPV_DINOV2_VARIANT=vits14
# phải chia hết cho patch size 14
RPV_IMAGE_SIZE=336
# cờ tương thích API cũ; resize_mode chọn phép xử lý thực tế
RPV_CENTER_CROP=1
# chỉ tác động ảnh khi RPV_RESIZE_MODE=crop
RPV_CROP_RATIO=0.875
# pad giữ toàn bộ vật thể; crop/stretch dùng cho ablation
RPV_RESIZE_MODE=pad
# tránh xung đột OpenMP trong Conda Windows
MKL_THREADING_LAYER=SEQUENTIAL
# để trống: tự chọn CUDA nếu có, nếu không dùng CPU
RPV_DEVICE=
# giữ batch size hiện tại
RPV_BATCH_SIZE=16
# số tâm tối đa cho mỗi SKU
RPV_CENTROIDS=1
# hiển thị top-k và mọi ứng viên hợp lệ; 0: tất cả
RPV_TOP_K=5
# lật ngang và trung bình embedding khi suy luận
RPV_TTA=0
# cache đặc trưng backbone theo nội dung ảnh
RPV_EMBED_CACHE=1
# số mục cache tối đa
RPV_CACHE_MAX=200000
# để trống khi train mới; sau train nạp đúng head đã tạo
RPV_PROJECTION_CKPT=

# --- DINOv2 offline (tùy chọn) ---
# Mặc định dùng cache Torch hoặc tự tải; chỉ bỏ comment khi có file local thực tế.
# RPV_DINOV2_REPO=vendor/dinov2
# RPV_DINOV2_WEIGHTS=weights/dinov2_vits14_pretrain.pth

# --- Rủi ro và hiệu chỉnh ---
# alpha conformal; coverage mục tiêu của tập gốc = 1 - alpha
# Alpha, energy temperature and target known recall apply to prototype decisions.
# Prototype distances are Euclidean; the selection score is not a probability.
RPV_ALPHA=0.1
RPV_TARGET_KNOWN_RECALL=0.8
# energy; distance dùng cho đối chứng
RPV_OOD_METHOD=energy
# chốt trước khi đọc kết quả test
RPV_ENERGY_TEMPERATURE=0.1
# risk mục tiêu trên known-calib + reserved-calibration; phải đo lại trên test
RPV_TARGET_RISK=0.04
# dưới mức này dùng ngưỡng toàn cục
RPV_MIN_CALIB=8
# giao thức của dataset hiện tại
RPV_K_SHOT=2
RPV_CLASS_SPLIT_SEED=1
RPV_CALIB_TEST_SEED=401

# --- Policy nghiệp vụ ---
# VND: giá trị cao kèm cảnh báo cần nhân viên kiểm tra
RPV_HIGH_VALUE=500000
RPV_EXPIRY_WARN_DAYS=3
# SKU khác gần hơn quá mức này thì cần hỗ trợ
RPV_VERIFY_MARGIN_ASSIST=0.15

# --- Đường dẫn chung với terminal/run_all ---
RPV_DATA_DIR=data/dataset_v2
RPV_DB=var/thesis_v4/rpv.db
RPV_BANK=var/thesis_v4/prototypes.json
RPV_CALIB=var/thesis_v4/calibration.json
RPV_AUDIT=var/thesis_v4/audit.jsonl
RPV_REPORTS=var/thesis_v4/reports
RPV_CACHE_DIR=var/embed_cache
RPV_HEAD_OUT=var/thesis_v4/projection_head.pt

# --- Kết nối ngoài ---
# Dữ liệu cộng đồng không thay thế chứng từ và không chứng minh xuất xứ.
RPV_EXTERNAL_ADAPTERS=0

# Frozen NoAux head; support-only prototypes; six independent extra classes calibrate risk.
RPV_TRAINING_PROTOCOL=catalog_grouped
RPV_CONFORMAL_SCORE=relative
RPV_CONFIDENCE_METHOD=energy
RPV_RISK_CALIBRATION=six_extra_cal

# Few-shot catalog: DINO projection + normalized mean prototype per SKU.
RPV_CATALOG_BACKEND=prototype

# CPU threads used by NumPy/Torch; existing environment overrides these defaults.
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
RPV_DECISION_RULE=prototype_selective
RPV_PROTOTYPE_COLOR_WEIGHT=0.3
