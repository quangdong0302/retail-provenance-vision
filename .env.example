# Sao chép thành .env và sửa nếu cần. Mọi biến đều có mặc định hợp lý.

# --- Thị giác ---
RPV_ENCODER=dinov2             # dinov2 (mặc định, dùng cho mọi số liệu báo cáo)
                               # classical = baseline thủ công, không cần torch
RPV_DINOV2_VARIANT=vits14      # vits14(384) | vitb14(768) | vitl14(1024) | vitg14(1536)
RPV_IMAGE_SIZE=224             # PHẢI chia hết cho 14 (112,126,...,224,238,...)
RPV_CENTER_CROP=1              # tương thích API cũ; encoder v2 chọn bằng RPV_RESIZE_MODE
RPV_CROP_RATIO=0.875            # chỉ tác động ảnh khi RPV_RESIZE_MODE=crop
RPV_RESIZE_MODE=pad            # pad giữ toàn bộ vật thể; crop/stretch dành cho ablation
MKL_THREADING_LAYER=SEQUENTIAL # cấu hình kiểm tra Conda trên máy Windows hiện tại
RPV_DEVICE=                    # để trống = tự chọn cuda nếu có
RPV_BATCH_SIZE=32
RPV_CENTROIDS=2                # số tâm mỗi SKU (>1 để bao biến thể của cùng mặt hàng)
RPV_TOP_K=5                   # hiển thị top-k và mọi SKU hợp lệ; 0 = tất cả
RPV_TTA=1
RPV_EMBED_CACHE=1              # cache embedding theo hash ảnh; gần như bắt buộc với DINOv2
RPV_PROJECTION_CKPT=           # để trống khi train mới; sau train dùng head vừa tạo

# --- Chạy DINOv2 offline (máy bảo vệ khóa luận thường không có mạng) ---
# RPV_DINOV2_REPO=/duong/dan/dinov2                  # clone facebookresearch/dinov2
# RPV_DINOV2_WEIGHTS=/duong/dan/dinov2_vits14_pretrain.pth

# --- Rủi ro & hiệu chỉnh ---
RPV_ALPHA=0.10                 # mức rủi ro conformal (coverage mục tiêu = 1 - alpha)
RPV_TARGET_KNOWN_RECALL=0.90
RPV_MIN_CALIB=8                # dưới mức này thì SKU dùng ngưỡng toàn cục
RPV_K_SHOT=3
RPV_CLASS_SPLIT_SEED=1
RPV_CALIB_TEST_SEED=123

# --- Policy nghiệp vụ ---
RPV_HIGH_VALUE=500000          # VND: trên mức này, có cảnh báo là phải gọi nhân viên
RPV_EXPIRY_WARN_DAYS=3
RPV_VERIFY_MARGIN_ASSIST=0.15  # khai đúng nhưng SKU khác gần hơn quá mức này -> gọi người

# --- Đường dẫn ---
RPV_DATA_DIR=data/dataset_v2
RPV_DB=var/thesis/rpv.db
RPV_BANK=var/thesis/prototypes.json
RPV_CALIB=var/thesis/calibration.json
RPV_AUDIT=var/thesis/audit.jsonl
RPV_REPORTS=var/thesis/reports
RPV_CACHE_DIR=var/embed_cache
RPV_HEAD_OUT=var/thesis/projection_head.pt

# --- Kết nối ngoài ---
# TẮT mặc định. Bật chỉ khi cần thử adapter Open Food Facts; dữ liệu cộng đồng
# KHÔNG có giá trị chứng từ và không được dùng để kết luận nguồn gốc.
RPV_EXTERNAL_ADAPTERS=0
